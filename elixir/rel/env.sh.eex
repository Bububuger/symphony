#!/bin/sh
# Environment configuration for Symphony release.
# This file is sourced before the release boots.

# Resolve the release root directory (two levels up from bin/symphony)
RELEASE_ROOT="$(cd "$(dirname "$0")/.." && pwd)"
export RELEASE_ROOT

# Set HOME if not already set (needed in some container environments)
: "${HOME:=/root}"
export HOME

# Optionally load a .env file from the project workspace if present
if [ -f "${HOME}/.config/symphony/env" ]; then
  # shellcheck disable=SC1090
  . "${HOME}/.config/symphony/env"
fi

# K8s: set release node name from pod IP (headless service DNS)
export RELEASE_NODE="${RELEASE_NODE:-symphony@$(hostname -i)}"
export RELEASE_DISTRIBUTION="${RELEASE_DISTRIBUTION:-name}"
export RELEASE_COOKIE="${RELEASE_COOKIE:-symphony_cluster_cookie}"
